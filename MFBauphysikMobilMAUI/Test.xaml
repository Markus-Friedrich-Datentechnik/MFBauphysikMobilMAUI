<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:custom="clr-namespace:MFBauphysikMobilMAUI.CustomRenderer"
             x:Class="MFBauphysikMobilMAUI.Test"
             Title="Test">
    <NavigationPage.TitleView>
        <StackLayout Orientation="Horizontal">
            <ImageButton Source="back.png" Clicked="Back_Clicked" 
                        BackgroundColor="{StaticResource TransparentBackground}" HorizontalOptions="Start"/>
            <Label Text="Befestiger" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                  TextColor="{StaticResource TitleTextColor}" FontSize="{Binding SizeTitle}" FontAttributes="Bold"/>
            <ImageButton Source="next.png" Margin="0,0,10,0"
                        BackgroundColor="{StaticResource TransparentBackground}" HorizontalOptions="End" 
                        IsVisible="true" x:Name="checkButton"/>
        </StackLayout>
    </NavigationPage.TitleView>


    <ContentPage.Resources>
        <Style TargetType="Grid">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" 
                                 Value="{StaticResource TextColor Blue}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Orientation="Vertical">
            <!--Searchbar-->
            <Frame Grid.Row="0" 
    Style="{AppThemeBinding Light={StaticResource FrameStylelight}, Dark={StaticResource FrameStyleDark}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Entry x:Name="SearchBar" Grid.Column="0" 
                        TextChanged="SearchBar_TextChanged" 
            Keyboard="Plain"
            Placeholder="Suchen" PlaceholderColor="{StaticResource Gray300}"
            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                    <Image Source="suchen_2.png" Grid.Column="1"/>
                </Grid>
            </Frame>

            <!--CollectionView-->
            <ScrollView>
                <CollectionView ItemsSource="{Binding Aufbau}"
                             SelectionChanged="collection_view_SelectionChanged" BackgroundColor="Transparent"
                 SelectionMode="Single" x:Name="collection_view">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="1"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Padding="10,10,0,0"
                        Text="{Binding Bezeichnung}" FontSize="{Binding SizeClass}" />
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}"
                              Grid.Row="1" VerticalOptions="End"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </StackLayout>
    </ScrollView>
</ContentPage>
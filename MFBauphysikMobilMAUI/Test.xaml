<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:custom="clr-namespace:MFBauphysikMobilMAUI.CustomRenderer"
             x:Class="MFBauphysikMobilMAUI.Test"
             Title="Test">
    <ListView x:Name="listBefestiger" 
              SelectionMode="Single" 
              ItemSelected="listBefestiger_ItemSelected"
              HasUnevenRows="True"
              SeparatorColor="{StaticResource TitleBackgroundColor}">
        <ListView.ItemTemplate>
            <DataTemplate>
                <ViewCell >
                    <Grid Padding="10">
                        <Label Text="{Binding B}" FontSize="{Binding SizeClass}"/>
                    </Grid>
                </ViewCell>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>

</ContentPage>
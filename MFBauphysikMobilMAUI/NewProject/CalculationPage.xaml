<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MFBauphysikMobilMAUI.NewProject.CalculationPage"
             xmlns:customview="clr-namespace:MFBauphysikMobilMAUI.CustomRenderer"
             xmlns:converter="clr-namespace:MFBauphysikMobilMAUI.Converters"
             xmlns:effects="clr-namespace:MFBauphysikMobilMAUI.Effects"
             NavigationPage.HasBackButton="False">


    <NavigationPage.TitleView>
        <StackLayout Orientation="Horizontal">
            <ImageButton Source="back.png" BackgroundColor="{StaticResource TransparentBackground}"
              Grid.Column="0" Clicked="Back_Clicked"/>
            <StackLayout Orientation="Vertical" HorizontalOptions="CenterAndExpand">
                <Label Text="Bauphysikalische Berechnung" 
                       HorizontalOptions="CenterAndExpand"  VerticalOptions="CenterAndExpand"
                       TextColor="{StaticResource TitleTextColor}" 
                           FontSize="Medium" FontAttributes="Bold"/>
            </StackLayout>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.ToolbarItems>

        <ToolbarItem 
            
            IconImageSource="menu.png"
            Clicked="ToolbarItem_Clicked"
            Order="Primary"
            Priority="0"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BoolToColorConverter x:Key="BoolToColor"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Tabview-->
        <Grid Padding="5" Grid.Row="0" 
              BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimaryColor}, Dark={StaticResource DarkPrimaryColor}}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--Deckblatt-->
            <Label Text="Deckblatt" TextColor="{StaticResource LabelButton}"  Grid.Column="0"
                   FontSize="{Binding SizeDefault}"
                   x:Name="DeckblattButton" TextDecorations="Underline" FontAttributes="Bold" Padding="5">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Deckblatt_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

            <!--U-Wert Basiskonstruktion-->
            <Label Text="U-Wert" TextColor="{StaticResource LabelButton}"  Grid.Column="1"
                   x:Name="UwertBasisButton" Padding="5"  FontSize="{Binding SizeDefault}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Basis_Tapped"/>
                </Label.GestureRecognizers>
            </Label>      
           
            <!--Befestiger-->
            <Label Text="Befestiger" TextColor="{StaticResource LabelButton}" Grid.Column="2" 
                   x:Name="BefestigerButton" Padding="5"  FontSize="{Binding SizeDefault}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Befestiger_Tapped"/>
                </Label.GestureRecognizers>
            </Label>            
            
        </Grid>

        <!--Anzeige Deckblatt-->
        <Grid Grid.Row="1" x:Name="DeckblattTab" IsVisible="true" 
            BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimaryColor}, Dark= {StaticResource DarkPrimaryColor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!--Klimadaten und Feuchtenachweis-->
            <Grid Grid.Row="0" Padding="10,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5*"/>
                    <!--RowDefinition Height="3*"/-->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Text="{Binding Aufbau}" Grid.Row="0" Grid.ColumnSpan="2"
                       FontAttributes="Italic" FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                <Label Text="Klimadaten: " FontAttributes="Bold"  FontSize="{Binding SizeDefault}"
                       Grid.Row="1" Grid.Column="0"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                <Label Text="DIN 4108 normal"  FontSize="{Binding SizeDefault}"
                       Grid.Row="1" Grid.Column="1"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                <Label Text="U-Wert: " FontAttributes="Bold"  FontSize="{Binding SizeDefault}"
                       Grid.Row="2" Grid.Column="0"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                <Label Text="{Binding Delta_U, StringFormat='{0:N2} W/(m&#178;* K)'}"  FontSize="{Binding SizeDefault}"
                       Grid.Column="1" Grid.Row="2"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                <Label Text="Konstruktionstyp:" Grid.Row="3" Grid.Column="0"
                       FontAttributes="Bold" FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                <Label Text="{Binding Konstruktionstyp}" Grid.Row="3" Grid.Column="1"
                       FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                <Label Text="Feuchtenachweis: &#10;(Höhe NN &lt; 700m)"  FontAttributes="Bold"  FontSize="{Binding SizeDefault}" 
                       Grid.Row="4" Grid.Column="0"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                <Label FontSize="{Binding SizeDefault}" x:Name="Feuchtenachweis" FontAttributes="Bold"
                       Grid.Row="4" Grid.Column="1" 
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                <!--Meldung wenn kein Tauwasserausfällt -->
                <Label Grid.Row="5" Grid.ColumnSpan="2" FontAttributes="Bold" FontSize="{Binding SizeDefault}"
                       IsVisible="false" x:Name="MeldungDicke"
                       Text="Nachweis nicht erforderlich, da kein Tauwasser ausfällt"
                        TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                <!--Meldung bei mehr als 2 Tauwasserebene-->
                <Label Grid.Row="5" Grid.ColumnSpan="2" FontAttributes="Bold" 
                       x:Name="Meldung3Ebene" IsVisible="false" FontSize="{Binding SizeDefault}"
                       Text="Es kann nur mit max. 2 Tauwasserebenen gerechnet werden!" 
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                <!--Grid Tauwassermasse und Verdunstungsmasse-->
                <Grid Grid.Row="5" Grid.ColumnSpan="2" IsVisible="false" x:Name="NachweisGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Label Text="Tauwassermasse WT: " FontSize="{Binding SizeDefault}"
                           Grid.Row="0" Grid.Column="0" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                    <Label Text="{Binding Tauwassermasse, StringFormat='{0:N0} g/m&#178;'}" 
                           Grid.Row="0" Grid.Column="1" FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                    <!--, StringFormat='{0:N0} g/m&#178;'-->

                    <Label Text="Verdunstungsmasse WV: " Grid.Row="1" Grid.Column="0" 
                           FontAttributes="Bold" FontSize="{Binding SizeDefault}"
                    TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                    <Label Text="{Binding Verdunstungsmasse, StringFormat='{0:N0} g/m&#178;'}" 
                           Grid.Row="1" Grid.Column="1" FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                    <Label Text="max. zul. Tauwassermenge:" Grid.Row="2" Grid.Column="0" 
                           FontAttributes="Bold" FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                    <Label Text="{Binding ZulTauwasser, StringFormat='{0:N0} g/m&#178;'}" 
                           Grid.Row="2" Grid.Column="1" FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                    
                    <!--Schlussfolgerung-->
                    <Label Grid.Row="3" Grid.ColumnSpan="2" FontAttributes="Bold" 
                           Padding="0, 10, 0, 0" x:Name="Schluss" FontSize="{Binding SizeDefault}"
       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"
       />
                </Grid>                             
              

                <Frame x:Name="FrameBasis" IsVisible="true" Grid.Row="6" Grid.ColumnSpan="2"
            Style="{AppThemeBinding Light={StaticResource FrameStylelight}, Dark={StaticResource FrameStyleDark}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <!--Überschrift-->
                            <Label Text="Basiskonstruktion" Grid.Row="0" Grid.Column="0" 
                               FontAttributes="Bold" FontSize="{Binding SizeDefault}"
TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                            <Label Text="Dampfteildruck [Pa]" Grid.Row="0" Grid.Column="1" 
                               FontAttributes="Bold" HorizontalOptions="CenterAndExpand"
                               FontSize="{Binding SizeDefault}"
    TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                            <ListView x:Name="listBasis" Grid.Row="1" SelectionMode="None" Grid.ColumnSpan="2"
       SeparatorVisibility="Default"  HasUnevenRows="True"
       SeparatorColor="{StaticResource TextColor Blue}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Grid Padding="5,0,0,0" RowSpacing="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <!--ColumnDefinition Width="*"/-->
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Label Text="{Binding Bezeichnung}" FontSize="{Binding SizeClass}"
                                                   Grid.Row="0" Grid.Column="0"
                        TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                                <!--Label Text="{Binding Dicke, StringFormat='{0:N4} m'}" FontSize="{Binding SizeClass}"
                                                   Grid.Row="1" Grid.Column="0"
                        TextColor="{StaticResource TextColor Grey}"/-->

                                                <!--Label Text="{Binding Dampfsättigungsdruck, StringFormat='{0:N0}'}" Grid.Row="0" Grid.Column="1"/-->
                                                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="0.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Text="{Binding Dampfteildruck, StringFormat='{0:N0}'}" 
                                                       Grid.Column="0" FontAttributes="{Binding FontBold}" 
                                                       FontSize="{Binding SizeClass}"
                        TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                                    <Label Text="TW" Grid.Column="1" IsVisible="{Binding TW}" FontSize="{Binding SizeClass}" 
                                                       TextColor="{StaticResource TextColor Blue}"/>


                                                </Grid>
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                </Frame>
            </Grid>

            <BoxView BackgroundColor="{StaticResource TitleBackgroundColor}" Grid.Row="1" />
            <Grid Grid.Row="1" Padding="20,0,0,0">

                <ImageButton BackgroundColor="{StaticResource TransparentBackground}" 
                             Source="tools.png" Clicked="Konstruktion_Clicked" WidthRequest="50"
                             HorizontalOptions="Start"/>

            </Grid>
        </Grid>

        <!--Anzeige UwertBasis-->
        <Grid Grid.Row="1" x:Name="BasisUwert" IsVisible="False" 
              BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimaryColor}, Dark={StaticResource DarkPrimaryColor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!--ListView Bauteile-->
            <Frame Style="{AppThemeBinding Light={StaticResource FrameStylelight}, Dark={StaticResource FrameStyleDark}}">
                <ListView x:Name="listBasisUwert"  Grid.Row="0" Grid.Column="0"
                          Header="{Binding .}" HasUnevenRows="True"
                          ItemSelected="OnSelected_ItemSelected_Basis"
                          Footer="{Binding .}"     SelectionMode="Single"
                          SeparatorVisibility="Default"
                      SeparatorColor="{StaticResource TextColor Blue}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!--Überschrift Zeile-->
                                <Label Text="U-Wert Basiskonstruktion" Grid.Column="0" Grid.Row="0" FontAttributes="Bold"
                            HorizontalOptions="Start" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                <Label Text="Dicke" Grid.Column="1" Grid.Row="0" FontAttributes="Bold"
                            HorizontalOptions="Center" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                <Label Text="R" Grid.Column="2" Grid.Row="0" FontAttributes="Bold"
                            HorizontalOptions="Center" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                <!--Einheit Zeile-->
                                <Label Text="[m]" Grid.Row="1" Grid.Column="1" 
                            HorizontalOptions="Center" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                <Label Text="[m&#178; * K/W]" Grid.Row="1" Grid.Column="2" 
                            HorizontalOptions="Center" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                <!--Luft innen-->
                                <Label Text="Luft innen" Grid.Row="2" Grid.Column="0" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                <Label Text="0.1000" Grid.Column="2" Grid.Row="2" 
                            HorizontalOptions="Center" FontSize="{Binding SizeDefault}"
                        TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.FooterTemplate>
                        <DataTemplate>
                            <Grid Padding="5" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Label Text="Luft außen" Grid.Row="0" Grid.Column="0" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                <Label Text=" 0.0400" Grid.Column="2" Grid.Row="0" 
                            HorizontalOptions="Center" FontSize="{Binding SizeDefault}"
                        TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                <Label Text="Rges [m&#178; * K/W]" FontAttributes="Bold" 
                            Grid.Column="0" Grid.Row="1" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                <Label Text="{Binding Rbasis, StringFormat='{0:N3}'}" FontSize="{Binding SizeDefault}"
                            Grid.Column="2" Grid.Row="1" HorizontalOptions="Center" 
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                <!--Visible wenn Befestiger oder Luftspalte existiert-->
                                <Grid x:Name="Grid_dU_Basis" Grid.Row="2" Grid.ColumnSpan="3" IsVisible="{Binding BefestigerBoolean}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Label Text="{Binding AnteilKorrektur, StringFormat = 'dU(f) + dU(g) = {0:N2} % >= 3%'}"
                                FontAttributes="Bold" Grid.Row="0"  Grid.ColumnSpan="2" FontSize="{Binding SizeDefault}"
                                TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                    <Label Text="{Binding Gesamt_du, StringFormat='{0:N3}'}" HorizontalOptions="Center" 
                                Grid.Column="2" Grid.Row="0" FontSize="{Binding SizeDefault}"
                                TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                    <Label Text="U-Wert [W / (m&#178;* K)]" FontAttributes="Bold" 
                                Grid.Row="1" Grid.ColumnSpan="2" FontSize="{Binding SizeDefault}"
                                TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                    <Label Text="{Binding Delta_U,StringFormat='{0:N2}'}" 
                                Grid.Row="1" Grid.Column="2" HorizontalOptions="Center"
                                FontAttributes="Bold" FontSize="{Binding SizeDefault}"
                                TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                </Grid>

                                <!--Visible wenn Befestiger nicht existiert-->
                                <Grid x:Name="Grid_UBasis" Grid.Row="2" Grid.ColumnSpan="3" IsVisible="{Binding BefestigerBooleanEmpty}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Text="U-Wert [W / (m&#178;* K)]" FontAttributes="Bold" 
                                Grid.Row="0" Grid.ColumnSpan="2" FontSize="{Binding SizeDefault}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                    <Label Text="{Binding Ubasis, StringFormat='{0:N2}'}" FontSize="{Binding SizeDefault}"
                                Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                </Grid>

                            </Grid>
                        </DataTemplate>
                    </ListView.FooterTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid Padding="5,0,0,0" RowSpacing="0">                                   
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.5*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Text="{Binding Bezeichnung}" Grid.Row="0" Grid.Column="0" FontSize="{Binding SizeClass}"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                    <Label Text="{Binding Dicke, StringFormat='{0:N4}'}" FontSize="{Binding SizeClass}"
                            Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                    <Label Text="{Binding Wärmeleitfähigkeit, StringFormat='{0:N3} W/(m*K)'}" 
                            Grid.Row="1" Grid.Column="0" FontSize="{Binding SizeClass}"
                            TextColor="{StaticResource TextColor Grey}"/>

                                    <Label Text="{Binding R, StringFormat='{0:N4}'}" FontSize="{Binding SizeClass}"
                                Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                                    <Image Grid.Column="3" Source="move.png" IsVisible="False">
                                        <Image.GestureRecognizers>
                                            
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <!--Grid.GestureRecognizers>
                                        <DragGestureRecognizer CanDrag="True"
                                                               DragStarting="DragGestureRecognizer_DragStarting"
                                                               DragStartingCommand="{Binding BindingContext.ItemDragged, Source={x:Reference listBasisUwert}}"
                                                               DragStartingCommandParameter="{Binding}"/>
                                        <DropGestureRecognizer AllowDrop="True"
                                                               DragLeaveCommand="{Binding BindingContext.ItemDragLeave, Source={x:Reference listBasisUwert}}"
                                                               DragLeaveCommandParameter="{Binding}"
                                                               DragOverCommand="{Binding BindingContext.ItemDraggedOver, Source={x:Reference listBasisUwert}}"
                                                               DragOverCommandParameter="{Binding}"
                                                               Drop="DropGestureRecognizer_Drop"
                                                               DropCommand="{Binding BindingContext.ItemDropped, Source={x:Reference listBasisUwert}}"
                                                               DropCommandParameter="{Binding}"/>                                        
                                    </Grid.GestureRecognizers-->
                                </Grid>                                
                            </ViewCell>                            
                        </DataTemplate>
                    </ListView.ItemTemplate>                 
                </ListView>
            </Frame>
            
            <!--Plus - Bauteil einfügen-->
            <BoxView BackgroundColor="{StaticResource TitleBackgroundColor}" Grid.Row="2" x:Name="BoxPlus" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <ImageButton Source="plus.png"  Grid.Column="0"
                             BackgroundColor="{StaticResource TransparentBackground}" 
                     Clicked="Bauteil_Einfügen_Clicked" x:Name="ButtonPlus"
                     HorizontalOptions="Start"/>
                <ImageButton Source="ic_edit.png" BackgroundColor="{StaticResource TransparentBackground}" 
                             Grid.Column="1" IsVisible="False"
                             x:Name="ButtonEdit" HorizontalOptions="Start"/>

            </Grid>
            
            
        </Grid>      
        
        <!--Anzeige Befestiger-->
        <Grid x:Name="BefestigerFrame" Grid.Row="1" IsVisible="false"
              BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimaryColor}, Dark={StaticResource DarkPrimaryColor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!--Basis-->
            <Grid x:Name="FrameBefestigerBasis" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Text="Basiskonstruktion" FontAttributes="Bold" 
                       Grid.Row="0" Padding="10" FontSize="{Binding SizeDefault}"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                <ListView x:Name="listBefestiger" Grid.Row="1" RowHeight="150"
                          SeparatorVisibility="None"
                          BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimaryColor}, Dark={StaticResource DarkPrimaryColor}}"
                          ItemSelected="OnSelected_Befestiger_Basis">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid>
                                    <Frame
                                        Style="{AppThemeBinding Light={StaticResource FrameStylelight}, Dark={StaticResource FrameStyleDark}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Label Text="{Binding Bezeichnung}" 
                                               Grid.Row="0" Grid.ColumnSpan="2" 
                                               FontAttributes="Bold,Italic" FontSize="{Binding SizeClass}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                                            <Label Text="Anzahl Befestiger je m&#178;" 
                                               Grid.Row="1" Grid.Column="0" FontSize="{Binding SizeClass}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor},Dark={StaticResource DarkSecondaryColor}}"/>
                                            <Label Text="{Binding Anzahl}" FontSize="{Binding SizeClass}"
                                               Grid.Row="1" Grid.Column="1"
                                               TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor},Dark={StaticResource DarkSecondaryColor}}"/>

                                            <Label Text="Wärmeleitfähigkeit [W/(m*K)]" FontSize="{Binding SizeClass}"
                                               Grid.Row="2" Grid.Column="0"
                                               TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor},Dark={StaticResource DarkSecondaryColor}}"/>
                                            <Label Text="{Binding Wärmeleitfähigkeit_f}" 
                                               Grid.Row="2" Grid.Column="1" FontSize="{Binding SizeClass}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor},Dark={StaticResource DarkSecondaryColor}}"/>

                                            <Label Text="Durchmesser (mm)" FontSize="{Binding SizeClass}"
                                               Grid.Row="3" Grid.Column="0"
                                               TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor},Dark={StaticResource DarkSecondaryColor}}"/>
                                            <Label Text="{Binding Durchmesser}" FontSize="{Binding SizeClass}"
                                               Grid.Row="3" Grid.Column="1"
                                               TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor},Dark={StaticResource DarkSecondaryColor}}"/>
                                        </Grid>
                                    </Frame>
                                </Grid>
                            </ViewCell>                            
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            
            
            <BoxView BackgroundColor="{StaticResource TitleBackgroundColor}" Grid.Row="1" />
            <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="0">
                <ImageButton Padding="20,0,0,0" Source="material_neu.png" BackgroundColor="{StaticResource TransparentBackground}" 
                 Clicked="Befestiger_Einfügen_Clicked"
             HorizontalOptions="Start"/>
            </StackLayout>

        </Grid>
      
       
    </Grid>
</ContentPage>
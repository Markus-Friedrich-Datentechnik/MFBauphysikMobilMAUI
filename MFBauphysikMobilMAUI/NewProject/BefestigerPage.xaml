<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MFBauphysikMobilMAUI.NewProject.BefestigerPage"
             xmlns:custom="clr-namespace:MFBauphysikMobilMAUI.CustomRenderer"
             NavigationPage.HasBackButton="False">  
    
    <NavigationPage.TitleView>
        <StackLayout Orientation="Horizontal">
            <ImageButton Source="back.png" Clicked="Back_Clicked" 
                         BackgroundColor="{StaticResource TransparentBackground}" HorizontalOptions="Start"/>
            <Label Text="Befestiger" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                   TextColor="{StaticResource TitleTextColor}" FontSize="Title" FontAttributes="Bold"/>
            <ImageButton Source="next.png" Clicked="Check_Clicked" Margin="0,0,10,0"
                         BackgroundColor="{StaticResource TransparentBackground}" HorizontalOptions="End" 
                         IsVisible="true" x:Name="checkButton"/>
        </StackLayout>
    </NavigationPage.TitleView>


    <ContentPage.Resources>
        <Style TargetType="Grid">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" 
                                    Value="{StaticResource TextColor Blue}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    
    <ScrollView>
        <Grid>
            <StackLayout Orientation="Vertical" Grid.Row="0" x:Name="main_view">
                <!--SearchBar-->
                <Frame Grid.Row="0"
            Style="{AppThemeBinding Light={StaticResource FrameStylelight}, Dark={StaticResource FrameStyleDark}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Entry x:Name="SearchBar" Grid.Column="0" TextChanged="SearchBar_TextChanged"
                       Placeholder="Suchen" PlaceholderColor="{StaticResource Gray300}"
                       Keyboard="Plain"
                       TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>
                        <Image Source="suchen_2.png" Grid.Column="1"/>
                    </Grid>
                </Frame>

                <!--List Befestiger-->

                <ScrollView>
                    <!--ListView x:Name="listBefestiger" 
                  BackgroundColor="{StaticResource TransparentBackground}"
                      SelectionMode="Single" 
                      Grid.Row="1"
                      HasUnevenRows="True"
                      ItemSelected="listBefestiger_ItemSelected" 
                      SeparatorColor="{StaticResource TitleBackgroundColor}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <custom:MyViewCell SelectedBackGroundColor="{StaticResource TextColor Blue}">
                        <Grid Padding="10">
                            <Label Text="{Binding B}" FontSize="{Binding SizeClass}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightSecondaryColor}, Dark={StaticResource DarkSecondaryColor}}"/>

                        </Grid>

                    </custom:MyViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView-->
                    <CollectionView x:Name="listBefestiger" 
          BackgroundColor="{StaticResource TransparentBackground}"
              SelectionMode="Single" SelectionChanged="listBefestiger_SelectionChanged"
                ItemsSource="{Binding Aufbau}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                    </Grid.RowDefinitions>
                                    <Label Text="{Binding Bezeichnung}" Padding="10" Grid.Row="0" FontSize="{Binding Size_Def}"/>
                                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" 
                                 Grid.Row="1" VerticalOptions="End"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </StackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
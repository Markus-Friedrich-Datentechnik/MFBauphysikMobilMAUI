<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:models="clr-namespace:MFBauphysikMobilMAUI.Models" 
             x:DataType="models:EinstellungModel"
             x:Class="MFBauphysikMobilMAUI.Sortieren.SortierenPage"
             NavigationPage.HasBackButton="False">
    
    
    <NavigationPage.TitleView>
        <StackLayout Orientation="Horizontal">
            <ImageButton Source="back.png" BackgroundColor="{StaticResource TransparentBackground}" 
                         HorizontalOptions="Start" Clicked="Back_Clicked"/>

            <StackLayout Orientation="Vertical" HorizontalOptions="CenterAndExpand">               
                <Label Text="Sortieren" HorizontalOptions="Center" FontSize="Title" 
                       VerticalOptions="CenterAndExpand"
                       TextColor="{StaticResource TitleTextColor}"/>
            </StackLayout>           
        </StackLayout>
    </NavigationPage.TitleView>
    
    
    <StackLayout Padding ="10" 
              BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimaryColor}, Dark={StaticResource DarkPrimaryColor}}"
              Orientation="Vertical">
        <StackLayout Orientation="Vertical">
            <Frame HeightRequest="200" VerticalOptions="Start" 
    Style="{AppThemeBinding Light={StaticResource FrameStylelight}, Dark={StaticResource FrameStyleDark}}">
                <StackLayout >
                    <!--Button1-->
                    <RadioButton x:Name="neueste" Value="neueste" VerticalOptions="CenterAndExpand" 
                                Content="neueste oben"
                                CheckedChanged="RadioButton_CheckedChanged" IsChecked="{Binding Alt_Jung}">
                    </RadioButton>

                    <!--Button2-->
                    <RadioButton x:Name="älteste" Value="älteste" VerticalOptions="CenterAndExpand"
                                    IsChecked="{Binding Jung_Alt}" 
                                    CheckedChanged="RadioButton_CheckedChanged" Content="älteste oben">
                    </RadioButton>

                    <!--Button3-->
                    <RadioButton x:Name="a_z" Value="a_z"  
                  CheckedChanged="RadioButton_CheckedChanged" IsChecked="{Binding A_Z}"
                          Content="A -> Z">
                    </RadioButton>

                    <!--Button4-->
                    <RadioButton x:Name="z_a" Value="z_a" VerticalOptions="CenterAndExpand" 
                  CheckedChanged="RadioButton_CheckedChanged" IsChecked="{Binding Z_A}"
                          Content="Z -> A">
                    </RadioButton>
                </StackLayout>
            </Frame>
        </StackLayout>
    </StackLayout>

</ContentPage>